datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ClinicStatus {
  ACTIVE
  BLOCKED
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
  DELETED
}

enum SystemRole {
  USER
  ADMIN
}

enum ClinicRole {
  OWNER
  ADMIN
  PROFESSIONAL
  RECEPTIONIST
}

enum AuditActorType {
  ADMIN
  SYSTEM
}

enum LoginEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_FAILED_BLOCKED
  LOGOUT
}

enum AdminAuditAction {
  USER_BLOCKED
  USER_UNBLOCKED
  SESSIONS_REVOKED
  USER_PROMOTED
}

enum PatientStatus {
  ACTIVE
  ATTENTION
  INACTIVE
  ARCHIVED
}

enum ClinicActivityEntityType {
  CLINIC
  PATIENT
  PROCEDURE
  SCHEDULE
  INVENTORY
  FINANCE
  LEAD
  PLANNING
  PROPOSAL
  MAP
  CATALOG
  PROTOCOL
  PHOTO
  INCIDENT
  POST_CARE
  TEAM
  INVITATION
  PATIENT_PLAN
  ACADEMY
  AI
}

enum ClinicActivityAction {
  CLINIC_UPDATED
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_ARCHIVED
  PATIENT_RESTORED
  PROCEDURE_CREATED
  SCHEDULE_CREATED
  SCHEDULE_UPDATED
  SCHEDULE_CANCELLED
  RETURN_COMPLETED
  INVENTORY_CREATED
  INVENTORY_RESTOCKED
  INVENTORY_ADJUSTED
  FINANCE_ENTRY_CREATED
  FINANCE_ENTRY_VOIDED
  LEAD_CREATED
  LEAD_STAGE_CHANGED
  LEAD_CONVERTED
  LEAD_ARCHIVED
  PLANNING_CREATED
  PLANNING_UPDATED
  PLANNING_COMPLETED
  PLANNING_ARCHIVED
  PROPOSAL_CREATED
  PROPOSAL_SENT
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  MAP_CREATED
  MAP_UPDATED
  MAP_COMPLETED
  CATALOG_PROCEDURE_CREATED
  CATALOG_PROCEDURE_UPDATED
  PROTOCOL_CREATED
  PROTOCOL_UPDATED
  PHOTO_UPLOADED
  PHOTO_ARCHIVED
  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_RESOLVED
  INCIDENT_ARCHIVED
  POST_CARE_CREATED
  POST_CARE_COMPLETED
  POST_CARE_CANCELLED
  TEAM_MEMBER_INVITED
  TEAM_MEMBER_ROLE_CHANGED
  TEAM_MEMBER_REMOVED
  PATIENT_PLAN_CREATED
  PATIENT_PLAN_UPDATED
  PATIENT_PLAN_COMPLETED
}

enum ScheduleEventKind {
  PROCEDURE
  RETURN
  EVALUATION
  COMMERCIAL_CONTACT
  BLOCK
}

enum ScheduleEventStatus {
  CONFIRMED
  WAITING
  COMPLETED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PatientReturnStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

enum LedgerKind {
  REVENUE
  EXPENSE
}

enum LedgerSource {
  PROCEDURE
  MANUAL
  ADJUSTMENT
}

enum LeadStage {
  NEW_CONTACT
  EVALUATION_SCHEDULED
  PROPOSAL_SENT
  WON
  LOST
}

enum PlanningStatus {
  DRAFT
  COMPLETED
  CONVERTED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum MapMode {
  TWO_D
  THREE_D
}

enum MapStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

model Clinic {
  id                   String       @id @default(uuid())
  name                 String
  slug                 String       @unique
  status               ClinicStatus @default(ACTIVE)
  timezone             String       @default("America/Sao_Paulo")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  professionalName     String?      @map("professional_name")
  professionalRegistry String?      @map("professional_registry")
  address              String?
  city                 String?
  phone                String?
  email                String?
  instagram            String?

  users                ClinicUser[]
  patients             Patient[]
  activityLogs         ClinicActivityLog[]
  procedureRecords     ProcedureRecord[]
  productUsages        ProcedureProductUsage[]
  inventoryItems       InventoryItem[]
  inventoryMovements   InventoryMovement[]
  scheduleEvents       ScheduleEvent[]
  returns              PatientReturn[]
  ledgerEntries        LedgerEntry[]
  idempotencyKeys      IdempotencyKey[]
  leads                Lead[]
  facialPlannings      FacialPlanning[]
  proposals            Proposal[]
  procedureMaps        ProcedureMap[]
  catalogProcedures    CatalogProcedure[]
  protocols            Protocol[]
  patientPhotos        PatientPhoto[]
  incidents            Incident[]
  incidentUpdates      IncidentUpdate[]
  postCareFollowUps    PostCareFollowUp[]
  invitations          ClinicInvitation[]
  treatmentPlans       PatientTreatmentPlan[]
  aiConversations      AIConversation[]
  aiUsages             AIUsage[]
  featureOverrides     ClinicFeatureOverride[]
  notifications        Notification[]

  @@map("clinics")
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  phone         String?
  passwordHash  String     @map("password_hash")
  systemRole    SystemRole @default(USER) @map("system_role")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  lastLoginAt   DateTime?  @map("last_login_at")
  blockedAt     DateTime?  @map("blocked_at")
  blockedReason String?    @map("blocked_reason")

  clinics              ClinicUser[]
  sessions             Session[]
  loginEvents          LoginEvent[]
  adminAuditLogs       AdminAuditLog[]      @relation("AdminUser")
  targetAuditLogs      AdminAuditLog[]      @relation("TargetUser")
  passwordResetTokens  PasswordResetToken[]
  createdPatients      Patient[]            @relation("PatientCreatedBy")
  updatedPatients      Patient[]            @relation("PatientUpdatedBy")
  clinicActivityLogs   ClinicActivityLog[]
  createdProcedures    ProcedureRecord[]    @relation("ProcedureCreatedBy")
  createdMovements     InventoryMovement[]  @relation("MovementCreatedBy")
  createdSchedules     ScheduleEvent[]      @relation("ScheduleCreatedBy")
  createdLedgerEntries LedgerEntry[]        @relation("LedgerCreatedBy")
  idempotencyKeys      IdempotencyKey[]
  createdLeads         Lead[]               @relation("LeadCreatedBy")
  assignedLeads        Lead[]               @relation("LeadAssignedUser")
  createdPlannings     FacialPlanning[]     @relation("PlanningCreatedBy")
  createdProposals     Proposal[]           @relation("ProposalCreatedBy")
  createdMaps          ProcedureMap[]       @relation("MapCreatedBy")
  createdCatalog       CatalogProcedure[]   @relation("CatalogCreatedBy")
  createdProtocols     Protocol[]           @relation("ProtocolCreatedBy")
  uploadedPhotos       PatientPhoto[]
  createdIncidents     Incident[]           @relation("IncidentCreatedBy")
  createdIncidentUpdates IncidentUpdate[]
  sentInvitations      ClinicInvitation[]
  createdTreatmentPlans PatientTreatmentPlan[]
  lessonProgresses     AcademyLessonProgress[]
  aiConversations      AIConversation[]
  aiUsages             AIUsage[]
  notifications        Notification[]

  @@map("users")
}

model ClinicUser {
  id        String     @id @default(uuid())
  clinicId  String     @map("clinic_id")
  userId    String     @map("user_id")
  role      ClinicRole @default(OWNER)
  createdAt DateTime   @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("clinic_users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginEvent {
  id        String         @id @default(uuid())
  userId    String?        @map("user_id")
  event     LoginEventType
  ipAddress String?        @map("ip_address")
  userAgent String?        @map("user_agent")
  createdAt DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([event])
  @@map("login_events")
}

model AdminAuditLog {
  id           String           @id @default(uuid())
  actorType    AuditActorType   @default(ADMIN) @map("actor_type")
  adminUserId  String?          @map("admin_user_id")
  action       AdminAuditAction
  targetUserId String?          @map("target_user_id")
  metadata     Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  adminUser  User? @relation("AdminUser", fields: [adminUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Patient {
  id                      String        @id @default(uuid())
  clinicId                String        @map("clinic_id")
  name                    String
  cpf                     String?
  phone                   String?
  email                   String?
  city                    String?
  birthDate               DateTime?     @map("birth_date") @db.Date
  status                  PatientStatus @default(ACTIVE)
  mainProcedure           String?       @map("main_procedure")
  responsibleProfessional String?       @map("responsible_professional")
  leadSource              String?       @map("lead_source")
  createdByUserId         String?       @map("created_by_user_id")
  updatedByUserId         String?       @map("updated_by_user_id")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  archivedAt              DateTime?     @map("archived_at")

  clinic          Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  createdByUser   User?                   @relation("PatientCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?                   @relation("PatientUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  clinicalProfile PatientClinicalProfile?
  procedureRecords ProcedureRecord[]
  scheduleEvents  ScheduleEvent[]
  returns         PatientReturn[]
  ledgerEntries   LedgerEntry[]
  leads           Lead[]
  facialPlannings FacialPlanning[]
  proposals       Proposal[]
  procedureMaps   ProcedureMap[]
  photos          PatientPhoto[]
  incidents       Incident[]
  postCareFollowUps PostCareFollowUp[]
  treatmentPlans  PatientTreatmentPlan[]
  aiConversations AIConversation[]

  @@unique([clinicId, cpf])
  @@index([clinicId])
  @@index([clinicId, status])
  @@index([clinicId, name])
  @@index([clinicId, phone])
  @@index([clinicId, createdAt])
  @@map("patients")
}

model PatientClinicalProfile {
  id            String   @id @default(uuid())
  patientId     String   @unique @map("patient_id")
  skinType      String?  @map("skin_type")
  allergies     String?  @map("allergies")
  clinicalNotes String?  @map("clinical_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_clinical_profiles")
}

model ClinicActivityLog {
  id         String                   @id @default(uuid())
  clinicId   String                   @map("clinic_id")
  userId     String?                  @map("user_id")
  entityType ClinicActivityEntityType @map("entity_type")
  entityId   String                   @map("entity_id")
  action     ClinicActivityAction
  createdAt  DateTime                 @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@map("clinic_activity_logs")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  clinicId     String   @map("clinic_id")
  userId       String?  @map("user_id")
  key          String
  operation    String
  status       String   // "PENDING", "COMPLETED"
  resourceId   String?  @map("resource_id")
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([clinicId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ProcedureRecord {
  id                 String   @id @default(uuid())
  clinicId           String   @map("clinic_id")
  patientId          String   @map("patient_id")
  procedureName      String   @map("procedure_name")
  procedureCategory  String   @map("procedure_category")
  performedAt        DateTime @default(now()) @map("performed_at")
  professionalUserId String?  @map("professional_user_id")
  professionalName   String   @map("professional_name")
  regions            String[] @default([])
  value              Decimal  @db.Decimal(12, 2)
  directCost         Decimal  @default(0) @db.Decimal(12, 2) @map("direct_cost")
  notes              String?  @db.Text
  createdByUserId    String?  @map("created_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  clinic           Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient          Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdByUser    User?                   @relation("ProcedureCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  productUsages    ProcedureProductUsage[]
  inventoryOutputs InventoryMovement[]
  ledgerEntry      LedgerEntry?
  patientReturn    PatientReturn?
  photos           PatientPhoto[]
  incidents        Incident[]
  postCareFollowUps PostCareFollowUp[]

  @@index([clinicId])
  @@index([clinicId, performedAt])
  @@index([patientId])
  @@map("procedure_records")
}

model ProcedureProductUsage {
  id                  String   @id @default(uuid())
  clinicId            String   @map("clinic_id")
  procedureRecordId   String   @map("procedure_record_id")
  inventoryItemId     String   @map("inventory_item_id")
  productNameSnapshot String   @map("product_name_snapshot")
  brandSnapshot       String   @map("brand_snapshot")
  lotSnapshot         String   @map("lot_snapshot")
  unitSnapshot        String   @map("unit_snapshot")
  quantity            Decimal  @db.Decimal(12, 4)
  unitCostSnapshot    Decimal  @db.Decimal(12, 4) @map("unit_cost_snapshot")
  totalCost           Decimal  @db.Decimal(12, 2) @map("total_cost")
  createdAt           DateTime @default(now()) @map("created_at")

  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  procedureRecord ProcedureRecord @relation(fields: [procedureRecordId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@index([procedureRecordId])
  @@map("procedure_product_usages")
}

model InventoryItem {
  id             String    @id @default(uuid())
  clinicId       String    @map("clinic_id")
  name           String
  brand          String
  category       String
  contentUnit    String    @map("content_unit")
  contentPerPack Decimal   @db.Decimal(12, 4) @map("content_per_pack")
  packLabel      String    @map("pack_label")
  quantity       Decimal   @db.Decimal(12, 4)
  minQuantity    Decimal   @db.Decimal(12, 4) @map("min_quantity")
  packCost       Decimal   @db.Decimal(12, 2) @map("pack_cost")
  lot            String
  expiresAt      DateTime? @map("expires_at") @db.Date
  supplier       String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  archivedAt     DateTime? @map("archived_at")

  clinic        Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  movements     InventoryMovement[]
  productUsages ProcedureProductUsage[]

  @@index([clinicId])
  @@index([clinicId, category])
  @@map("inventory_items")
}

model InventoryMovement {
  id                  String                @id @default(uuid())
  clinicId            String                @map("clinic_id")
  inventoryItemId     String                @map("inventory_item_id")
  procedureRecordId   String?               @map("procedure_record_id")
  patientId           String?               @map("patient_id")
  type                InventoryMovementType
  productNameSnapshot String                @map("product_name_snapshot")
  lotSnapshot         String                @map("lot_snapshot")
  quantity            Decimal               @db.Decimal(12, 4)
  unit                String
  reason              String
  createdByUserId     String?               @map("created_by_user_id")
  createdAt           DateTime              @default(now()) @map("created_at")

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  procedureRecord ProcedureRecord? @relation(fields: [procedureRecordId], references: [id], onDelete: SetNull)
  createdByUser   User?            @relation("MovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([inventoryItemId])
  @@map("inventory_movements")
}

model ScheduleEvent {
  id                 String              @id @default(uuid())
  clinicId           String              @map("clinic_id")
  patientId          String?             @map("patient_id")
  patientName        String?             @map("patient_name")
  title              String
  kind               ScheduleEventKind   @default(PROCEDURE)
  status             ScheduleEventStatus @default(CONFIRMED)
  startsAt           DateTime            @map("starts_at")
  durationMin        Int                 @default(30) @map("duration_min")
  professionalUserId String?             @map("professional_user_id")
  professionalName   String?             @map("professional_name")
  room               String?
  value              Decimal?            @db.Decimal(12, 2)
  note               String?
  auto               Boolean             @default(false)
  createdByUserId    String?             @map("created_by_user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  cancelledAt        DateTime?           @map("cancelled_at")

  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient       Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdByUser User?           @relation("ScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  returns       PatientReturn[]

  @@index([clinicId, startsAt])
  @@index([clinicId, status])
  @@map("schedule_events")
}

model PatientReturn {
  id                String              @id @default(uuid())
  clinicId          String              @map("clinic_id")
  patientId         String              @map("patient_id")
  procedureRecordId String?             @unique @map("procedure_record_id")
  scheduleEventId   String?             @map("schedule_event_id")
  dueAt             DateTime            @map("due_at") @db.Date
  status            PatientReturnStatus @default(PENDING)
  reason            String
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  procedureRecord ProcedureRecord? @relation(fields: [procedureRecordId], references: [id], onDelete: SetNull)
  scheduleEvent   ScheduleEvent?   @relation(fields: [scheduleEventId], references: [id], onDelete: SetNull)

  @@index([clinicId, dueAt])
  @@index([patientId])
  @@map("patient_returns")
}

model LedgerEntry {
  id                  String       @id @default(uuid())
  clinicId            String       @map("clinic_id")
  patientId           String?      @map("patient_id")
  procedureRecordId   String?      @unique @map("procedure_record_id")
  kind                LedgerKind
  source              LedgerSource @default(MANUAL)
  category            String
  description         String
  amount              Decimal      @db.Decimal(12, 2)
  directCost          Decimal      @default(0) @db.Decimal(12, 2) @map("direct_cost")
  countsAsAppointment Boolean      @default(true) @map("counts_as_appointment")
  occurredAt          DateTime     @default(now()) @map("occurred_at")
  createdByUserId     String?      @map("created_by_user_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  voidedAt            DateTime?    @map("voided_at")

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  procedureRecord ProcedureRecord? @relation(fields: [procedureRecordId], references: [id], onDelete: SetNull)
  createdByUser   User?            @relation("LedgerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, occurredAt])
  @@index([clinicId, kind])
  @@map("ledger_entries")
}

// ==========================================
// MODELOS DA FASE 4: CRM, PLANEJAMENTO, PROPOSTAS, MAPAS, CATÁLOGO E PROTOCOLOS
// ==========================================

model Lead {
  id             String    @id @default(uuid())
  clinicId       String    @map("clinic_id")
  patientId      String?   @map("patient_id")
  name           String
  phone          String?
  email          String?
  interest       String
  source         String
  stage          LeadStage @default(NEW_CONTACT)
  value          Decimal   @default(0) @db.Decimal(12, 2)
  position       Int       @default(0)
  lastContact    DateTime  @default(now()) @map("last_contact")
  owner          String?
  temperature    String    @default("morno")
  note           String?   @db.Text
  scheduledFor   DateTime? @map("scheduled_for")
  createdByUserId String?  @map("created_by_user_id")
  assignedUserId String?   @map("assigned_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  wonAt          DateTime? @map("won_at")
  lostAt         DateTime? @map("lost_at")
  archivedAt     DateTime? @map("archived_at")

  clinic        Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient       Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdByUser User?      @relation("LeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedUser  User?      @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  proposals     Proposal[]

  @@index([clinicId, stage])
  @@index([clinicId, position])
  @@map("leads")
}

model FacialPlanning {
  id              String         @id @default(uuid())
  clinicId        String         @map("clinic_id")
  patientId       String         @map("patient_id")
  title           String         @default("Planejamento Facial")
  status          PlanningStatus @default(DRAFT)
  estimatedValue  Decimal        @default(0) @db.Decimal(12, 2) @map("estimated_value")
  notes           String?        @db.Text
  createdByUserId String?        @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  completedAt     DateTime?      @map("completed_at")
  archivedAt      DateTime?      @map("archived_at")

  clinic        Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient       Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdByUser User?                  @relation("PlanningCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  regions       FacialPlanningRegion[]
  proposals     Proposal[]
  treatmentPlans PatientTreatmentPlan[]

  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@map("facial_plannings")
}

model FacialPlanningRegion {
  id                  String   @id @default(uuid())
  clinicId            String   @map("clinic_id")
  planningId          String   @map("planning_id")
  treatmentLine       String   @map("treatment_line") // e.g. "toxina", "preenchimento", "bioestimulador"
  regionCode          String   @map("region_code") // e.g. "frontal", "glabela", "malar"
  regionName          String   @map("region_name")
  productName         String?  @map("product_name")
  quantity            String?
  unit                String?
  depth               String?
  technique           String?
  sessionsRecommended Int      @default(1) @map("sessions_recommended")
  extraFieldsData     Json?    @map("extra_fields_data")
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  planning FacialPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@index([planningId])
  @@map("facial_planning_regions")
}

model Proposal {
  id               String         @id @default(uuid())
  clinicId         String         @map("clinic_id")
  patientId        String         @map("patient_id")
  leadId           String?        @map("lead_id")
  facialPlanningId String?        @map("facial_planning_id")
  title            String
  note             String?        @db.Text
  subtotal         Decimal        @default(0) @db.Decimal(12, 2)
  discount         Decimal        @default(0) @db.Decimal(12, 2)
  total            Decimal        @default(0) @db.Decimal(12, 2)
  status           ProposalStatus @default(DRAFT)
  validUntil       DateTime?      @map("valid_until") @db.Date
  createdByUserId  String?        @map("created_by_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  sentAt           DateTime?      @map("sent_at")
  acceptedAt       DateTime?      @map("accepted_at")
  rejectedAt       DateTime?      @map("rejected_at")
  archivedAt       DateTime?      @map("archived_at")

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  facialPlanning FacialPlanning? @relation(fields: [facialPlanningId], references: [id], onDelete: SetNull)
  createdByUser  User?           @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items          ProposalItem[]
  treatmentPlans PatientTreatmentPlan[]

  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@map("proposals")
}

model ProposalItem {
  id             String   @id @default(uuid())
  proposalId     String   @map("proposal_id")
  nameSnapshot   String   @map("name_snapshot")
  detailSnapshot String?  @map("detail_snapshot")
  quantity       Decimal  @default(1) @db.Decimal(12, 4)
  unitPrice      Decimal  @db.Decimal(12, 2) @map("unit_price")
  totalPrice     Decimal  @db.Decimal(12, 2) @map("total_price")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_items")
}

model ProcedureMap {
  id              String    @id @default(uuid())
  clinicId        String    @map("clinic_id")
  patientId       String    @map("patient_id")
  patientName     String    @map("patient_name")
  procedureName   String    @map("procedure_name")
  mode            MapMode   @default(TWO_D)
  status          MapStatus @default(DRAFT)
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at")
  archivedAt      DateTime? @map("archived_at")

  clinic        Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdByUser User?               @relation("MapCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  points        ProcedureMapPoint[]

  @@index([clinicId, patientId])
  @@map("procedure_maps")
}

model ProcedureMapPoint {
  id             String   @id @default(uuid())
  procedureMapId String   @map("procedure_map_id")
  regionId       String   @map("region_id")
  regionName     String   @map("region_name")
  product        String
  quantity       String
  depth          String
  technique      String
  note           String?  @db.Text
  position2dX    Float?   @map("position_2d_x")
  position2dY    Float?   @map("position_2d_y")
  position3dX    Float?   @map("position_3d_x")
  position3dY    Float?   @map("position_3d_y")
  position3dZ    Float?   @map("position_3d_z")
  createdAt      DateTime @default(now()) @map("created_at")

  procedureMap ProcedureMap @relation(fields: [procedureMapId], references: [id], onDelete: Cascade)

  @@index([procedureMapId])
  @@map("procedure_map_points")
}

model CatalogProcedure {
  id                   String    @id @default(uuid())
  clinicId             String    @map("clinic_id")
  name                 String
  category             String
  description          String?   @db.Text
  defaultPrice         Decimal   @db.Decimal(12, 2) @map("default_price")
  estimatedDurationMin Int       @default(30) @map("estimated_duration_min")
  active               Boolean   @default(true)
  createdByUserId      String?   @map("created_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  archivedAt           DateTime? @map("archived_at")

  clinic        Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  createdByUser User?                  @relation("CatalogCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  protocolSteps ProtocolStep[]
  treatmentPlanItems PatientTreatmentPlanItem[]

  @@index([clinicId])
  @@map("catalog_procedures")
}

model Protocol {
  id              String    @id @default(uuid())
  clinicId        String    @map("clinic_id")
  name            String
  description     String?   @db.Text
  packagePrice    Decimal   @db.Decimal(12, 2) @map("package_price")
  active          Boolean   @default(true)
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  clinic        Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  createdByUser User?                  @relation("ProtocolCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  steps         ProtocolStep[]
  treatmentPlanItems PatientTreatmentPlanItem[]

  @@index([clinicId])
  @@map("protocols")
}

model ProtocolStep {
  id                 String   @id @default(uuid())
  protocolId         String   @map("protocol_id")
  catalogProcedureId String?  @map("catalog_procedure_id")
  procedureName      String   @map("procedure_name")
  label              String
  dayOffset          Int      @default(1) @map("day_offset")
  listPrice          Decimal  @db.Decimal(12, 2) @map("list_price")
  position           Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")

  protocol         Protocol          @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  catalogProcedure CatalogProcedure? @relation(fields: [catalogProcedureId], references: [id], onDelete: SetNull)

  @@index([protocolId])
  @@map("protocol_steps")
}

// ------------------------------------
// FASE 5: STORAGE, PHOTOS, INCIDENTS & POST-CARE
// ------------------------------------

enum PhotoType {
  BEFORE
  AFTER
  EVOLUTION
  CLINICAL
  INCIDENT
  OTHER
}

enum IncidentSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  MONITORING
  RESOLVED
  ARCHIVED
}

enum FollowUpStage {
  H24
  DAY_7
  DAY_15
}

enum FollowUpStatus {
  PENDING
  SENT
  COMPLETED
  CANCELLED
  OVERDUE
}

model PatientPhoto {
  id                String    @id @default(uuid())
  clinicId          String    @map("clinic_id")
  patientId         String    @map("patient_id")
  procedureRecordId String?   @map("procedure_record_id")

  storageKey       String    @map("storage_key")
  originalFileName String    @map("original_file_name")
  mimeType         String    @map("mime_type")
  fileSize         Int       @map("file_size")

  type             PhotoType @default(CLINICAL)
  bodyRegion       String?   @map("body_region")
  notes            String?   @db.Text

  capturedAt       DateTime  @default(now()) @map("captured_at")
  uploadedByUserId String?   @map("uploaded_by_user_id")

  createdAt        DateTime  @default(now()) @map("created_at")
  archivedAt       DateTime? @map("archived_at")

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedureRecord ProcedureRecord? @relation(fields: [procedureRecordId], references: [id], onDelete: SetNull)
  uploadedByUser  User?            @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  incidentPhotos  IncidentPhoto[]

  @@index([clinicId, patientId])
  @@index([clinicId, type])
  @@map("patient_photos")
}

model Incident {
  id                String           @id @default(uuid())
  clinicId          String           @map("clinic_id")
  patientId         String           @map("patient_id")
  procedureRecordId String?          @map("procedure_record_id")

  type              String
  severity          IncidentSeverity @default(MODERATE)
  status            IncidentStatus   @default(OPEN)

  report            String           @db.Text
  identifiedAt      DateTime         @default(now()) @map("identified_at")
  resolvedAt        DateTime?        @map("resolved_at")

  createdByUserId   String?          @map("created_by_user_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  archivedAt        DateTime?        @map("archived_at")

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  procedureRecord ProcedureRecord? @relation(fields: [procedureRecordId], references: [id], onDelete: SetNull)
  createdByUser   User?            @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  updates         IncidentUpdate[]
  incidentPhotos  IncidentPhoto[]

  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@map("incidents")
}

model IncidentUpdate {
  id              String          @id @default(uuid())
  clinicId        String          @map("clinic_id")
  incidentId      String          @map("incident_id")

  status          IncidentStatus?
  note            String          @db.Text

  createdByUserId String?         @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@map("incident_updates")
}

model IncidentPhoto {
  id             String @id @default(uuid())
  incidentId     String @map("incident_id")
  patientPhotoId String @map("patient_photo_id")

  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  patientPhoto PatientPhoto @relation(fields: [patientPhotoId], references: [id], onDelete: Cascade)

  @@unique([incidentId, patientPhotoId])
  @@map("incident_photos")
}

model PostCareFollowUp {
  id                String         @id @default(uuid())
  clinicId          String         @map("clinic_id")
  patientId         String         @map("patient_id")
  procedureRecordId String         @map("procedure_record_id")

  stage             FollowUpStage
  scheduledFor      DateTime       @map("scheduled_for")
  status            FollowUpStatus @default(PENDING)

  sentAt            DateTime?      @map("sent_at")
  completedAt       DateTime?      @map("completed_at")
  cancelledAt       DateTime?      @map("cancelled_at")

  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedureRecord ProcedureRecord @relation(fields: [procedureRecordId], references: [id], onDelete: Cascade)

  @@unique([procedureRecordId, stage])
  @@index([clinicId, scheduledFor])
  @@index([clinicId, status])
  @@map("post_care_follow_ups")
}

// ------------------------------------
// FASE 6: TEAM INVITATIONS, PATIENT PLANS, ACADEMY, AI & NOTIFICATIONS
// ------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum PlanItemStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AcademyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  PDF
  LINK
}

model ClinicInvitation {
  id              String           @id @default(uuid())
  clinicId        String           @map("clinic_id")
  email           String
  role            ClinicRole       @default(PROFESSIONAL)
  tokenHash       String           @unique @map("token_hash")
  status          InvitationStatus @default(PENDING)

  invitedByUserId String?          @map("invited_by_user_id")
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  revokedAt       DateTime?        @map("revoked_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  clinic        Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedByUser User?  @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, email])
  @@index([tokenHash])
  @@map("clinic_invitations")
}

model PatientTreatmentPlan {
  id               String      @id @default(uuid())
  clinicId         String      @map("clinic_id")
  patientId        String      @map("patient_id")
  facialPlanningId String?     @map("facial_planning_id")
  proposalId       String?     @map("proposal_id")

  name             String
  objective        String?     @db.Text
  status           PlanStatus  @default(ACTIVE)
  notes            String?     @db.Text

  createdByUserId  String?     @map("created_by_user_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  completedAt      DateTime?   @map("completed_at")
  archivedAt       DateTime?   @map("archived_at")

  clinic         Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient        Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facialPlanning FacialPlanning?           @relation(fields: [facialPlanningId], references: [id], onDelete: SetNull)
  proposal       Proposal?                 @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  createdByUser  User?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items          PatientTreatmentPlanItem[]

  @@index([clinicId, patientId])
  @@map("patient_treatment_plans")
}

model PatientTreatmentPlanItem {
  id                 String         @id @default(uuid())
  planId             String         @map("plan_id")
  catalogProcedureId String?        @map("catalog_procedure_id")
  protocolId         String?        @map("protocol_id")

  nameSnapshot       String         @map("name_snapshot")
  descriptionSnapshot String?       @map("description_snapshot") @db.Text
  sessionNumber      Int            @default(1) @map("session_number")
  plannedDate        DateTime?      @map("planned_date")
  status             PlanItemStatus @default(PLANNED)
  priceSnapshot      Decimal?       @db.Decimal(12, 2) @map("price_snapshot")
  position           Int            @default(0)

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  plan             PatientTreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  catalogProcedure CatalogProcedure?    @relation(fields: [catalogProcedureId], references: [id], onDelete: SetNull)
  protocol         Protocol?            @relation(fields: [protocolId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@map("patient_treatment_plan_items")
}

model AcademyCourse {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  description   String?       @db.Text
  coverImageKey String?       @map("cover_image_key")
  status        AcademyStatus @default(PUBLISHED)
  position      Int           @default(0)

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  publishedAt   DateTime?     @map("published_at")

  modules       AcademyModule[]

  @@map("academy_courses")
}

model AcademyModule {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?  @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  AcademyCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons AcademyLesson[]

  @@index([courseId])
  @@map("academy_modules")
}

model AcademyLesson {
  id            String        @id @default(uuid())
  moduleId      String        @map("module_id")
  title         String
  description   String?       @db.Text
  contentType   LessonType    @default(VIDEO) @map("content_type")
  videoUrl      String?       @map("video_url")
  content       String?       @db.Text
  attachmentKey String?       @map("attachment_key")
  durationMin   Int           @default(10) @map("duration_min")
  position      Int           @default(0)
  status        AcademyStatus @default(PUBLISHED)

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  module     AcademyModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses AcademyLessonProgress[]

  @@index([moduleId])
  @@map("academy_lessons")
}

model AcademyLessonProgress {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  lessonId       String    @map("lesson_id")
  completedAt    DateTime? @map("completed_at")
  lastAccessedAt DateTime  @default(now()) @map("last_accessed_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson AcademyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("academy_lesson_progresses")
}

model KnowledgeDocument {
  id              String        @id @default(uuid())
  title           String
  category        String
  content         String        @db.Text
  sourceReference String?       @map("source_reference")
  status          AcademyStatus @default(PUBLISHED)
  version         Int           @default(1)

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  publishedAt     DateTime?     @map("published_at")

  @@index([category])
  @@map("knowledge_documents")
}

model AIConversation {
  id         String    @id @default(uuid())
  clinicId   String    @map("clinic_id")
  userId     String    @map("user_id")
  patientId  String?   @map("patient_id")

  title      String
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  clinic   Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient  Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  messages AIMessage[]

  @@index([clinicId, userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")

  role           String   // "user", "assistant", "system"
  content        String   @db.Text
  tokensUsed     Int?     @map("tokens_used")
  sources        Json?

  createdAt      DateTime @default(now()) @map("created_at")

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AIUsage {
  id           String   @id @default(uuid())
  clinicId     String   @map("clinic_id")
  userId       String   @map("user_id")
  provider     String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  operation    String
  createdAt    DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
  @@map("ai_usages")
}

model ClinicFeatureOverride {
  id         String   @id @default(uuid())
  clinicId   String   @map("clinic_id")
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, featureKey])
  @@map("clinic_feature_overrides")
}

model Notification {
  id         String    @id @default(uuid())
  clinicId   String    @map("clinic_id")
  userId     String?   @map("user_id")

  type       String
  title      String
  message    String    @db.Text
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")

  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, userId])
  @@index([clinicId, readAt])
  @@map("notifications")
}
