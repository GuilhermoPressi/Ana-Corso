# Configuração do Banco de Dados PostgreSQL no Easypanel
DATABASE_URL="postgres://postgres:SUA_SENHA_AQUI@saas-ana-db:5432/saas_ana?sslmode=disable"

# Configurações adicionais
VITE_ROUTER=browser

# WhatsApp (Evolution API) — CRM de atendimento
EVOLUTION_API_URL="https://evolution.seudominio.com.br"
EVOLUTION_API_KEY="CHAVE_GLOBAL_DA_EVOLUTION"
# URL pública onde a Evolution consegue alcançar esta API (o webhook fica em /api/webhooks/evolution/...).
# Se vazio, usa FRONTEND_URL (o nginx do front repassa /api para a API).
PUBLIC_API_URL=""
